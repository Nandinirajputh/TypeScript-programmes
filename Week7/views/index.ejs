<!DOCTYPE html>
<html>
<head>
    <title>Student Registration</title>
</head>
<body>

    <h1>Welcome <%= name %>!</h1>

    <% if (error) { %>
        <p><%= error %></p>
    <% } %>

    <form action="/submit" method="POST">

        <label>Name:</label>
        <input type="text" name="name">

        <br><br>

        <label>Email:</label>
        <input type="text" name="email">

        <br><br>

        <button type="submit">Submit</button>

    </form>

</body>
</html>
